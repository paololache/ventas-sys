# ===== Base de datos =====
POSTGRES_PASSWORD=cambia-esta-clave
# DATABASE_URL se arma en docker-compose; para desarrollo local con SQLite:
# DATABASE_URL=sqlite:///./crm.db

# ===== Seguridad =====
# Genera una clave larga:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Superadmin de la PLATAFORMA (el que crea empresas). Se crea al arrancar si no existe.
BOOTSTRAP_ADMIN_EMAIL=admin@tuempresa.com
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-tambien

# ===== URLs públicas =====
# URL del frontend (para el botón "Abrir en la app" de Telegram y los correos)
PUBLIC_URL=http://localhost:3000
# URL pública del API (Telegram exige HTTPS para el webhook en producción)
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== Scheduler =====
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
DEFAULT_TIMEZONE=America/Lima

# ===== SMTP global (opcional) =====
# Cada empresa define su propio SMTP y su propio bot de Telegram desde la app (Empresas -> configuración).
# Estos valores son sólo un respaldo si una empresa no configura el suyo.
# Gmail: smtp.gmail.com / 587 / usuario / "contraseña de aplicación" de 16 caracteres
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
